# STRANDPATH environment variables.
#
# The student application is a static site and needs NONE of these. It runs
# entirely in the browser and stores records in localStorage. Deploy it to
# GitHub Pages with the workflow in .github/workflows/deploy.yml.
#
# Everything below is for the OPTIONAL Node/SQLite backend. That backend adds
# shared accounts, email verification, the administrator dashboard and
# cross-device records, and is built separately with VITE_API_MODE=server.

# --- Static build (read at build time by Vite) ------------------------------
# Project sites on GitHub Pages are served from /<repository>/.
# VITE_BASE_PATH=/STRANDPATH/
# Leave VITE_API_MODE unset for the static build. Set it to "server" only when
# building the optional backend-hosted version.
# VITE_API_MODE=server

# --- Optional server ---------------------------------------------------------
PORT=8787
# SQLite file path. Use an absolute path in production.
DB_PATH=server/data/strandpath.db
# Set to "production" behind HTTPS so cookies use the Secure flag.
NODE_ENV=development
# Public origin used in email links and OAuth redirects (no trailing slash).
# Example: https://strandpath.yourschool.edu.ph
APP_BASE_URL=

# --- Initial accounts (used by `npm run seed`; required for real deployments) --
# Both accounts are created once, marked verified, and forced to change this
# password at first sign-in. Passwords are never printed or committed.
INITIAL_ADMIN_EMAIL=jjardeleza@paterostechnologicalcollege.edu.ph
INITIAL_ADMIN_NAME=J. Jardeleza
INITIAL_ADMIN_PASSWORD=

INITIAL_STUDENT_EMAIL=jaruiorijardeleza@gmail.com
INITIAL_STUDENT_NAME=Klight
INITIAL_STUDENT_PASSWORD=

# --- Email delivery (SMTP, optional server only) ------------------------------
# Real delivery only. Without these, confirmation and reset emails are not sent;
# the API reports that honestly and the UI explains it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="StrandPath <no-reply@yourschool.edu.ph>"
# Optional development outbox: EMAIL_TRANSPORT=json writes .eml.json files to
# EMAIL_OUTBOX_DIR instead of sending. Never use this in production.
# EMAIL_TRANSPORT=json
# EMAIL_OUTBOX_DIR=server/data/outbox

# OTP and reset-link lifetime in minutes.
OTP_TTL_MINUTES=10

# --- Google Sign-In (optional server only) -----------------------------------
# Authorized JavaScript origin: APP_BASE_URL
# Authorized redirect URI:     APP_BASE_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
